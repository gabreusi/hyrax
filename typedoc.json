{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/dom/index.ts", "src/react/index.ts"],
  "tsconfig": "tsconfig.json",
  "out": "site/api",
  "docsRoot": "./site",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  // The index page of the reference is written by hand and merged in front of the module list.
  "readme": "site/.vitepress/api-readme.md",
  "mergeReadme": true,
  "name": "Hyrax API",
  // Short URLs (/api/hyrax/functions/clamp) and pages shaped for the site's theme: no breadcrumbs or
  // page header (the theme's title block shows the entrypoint), signatures as code, options as tables.
  "excludeScopesInPaths": true,
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "useCodeBlocks": true,
  "expandParameters": true,
  "tableColumnSettings": { "hideSources": true, "hideInherited": true, "leftAlignHeaders": true },
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "classPropertiesFormat": "table",
  "typeAliasPropertiesFormat": "table",
  "typeDeclarationFormat": "table",
  "indexFormat": "table",
  "pageTitleTemplates": { "index": "API reference", "module": "{name}", "member": "{name}" },
  "excludeInternal": true,
  // A fixed revision, so the links do not depend on where the docs were built.
  "gitRevision": "main",
  "sourceLinkTemplate": "https://github.com/gabreusi/hyrax/blob/{gitRevision}/{path}#L{line}",
  // Helper types that shape a public signature but are not part of the API: they are named in the
  // signature and explained in the guides, and exporting them would only widen what is promised.
  "intentionallyNotExported": [
    "Shortcuts",
    "NativeKeys",
    "shortcutKeys",
    "UnionToIntersection",
    "AliasFor"
  ],
  "treatWarningsAsErrors": true
}
